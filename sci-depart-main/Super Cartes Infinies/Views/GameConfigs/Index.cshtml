@model IEnumerable<Models.Models.GameConfig>

@{
    ViewData["Title"] = "Index";
}

<h1>GameConfig</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.QtManaParTour)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nbCardsToDraw)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.QtManaParTour)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nbCardsToDraw)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id">Edit</a> 
            </td>
        </tr>
}
    </tbody>
</table>
